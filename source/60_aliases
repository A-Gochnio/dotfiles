alias wttr="curl -4 wttr.in/"
alias untar="tar xvzf"
alias enplugscripts="npm install @enplug/scripts@latest"
alias staging_auth_token="~/.dotfiles/scripts/staging_auth_token"
alias dev_auth_token="~/.dotfiles/scripts/dev_auth_token"
alias staple_mac_screensaver="/usr/bin/xcrun stapler staple Enplug\ Screen\ Saver.saver"
alias notarization_progress="/usr/bin/xcrun altool --notarization-history 0 -u REDACTED_EMAIL -p @keychain:AC_PASSWORD"
alias notarize_mac_screensaver='f() { /usr/bin/xcrun altool --verbose --notarize-app --primary-bundle-id Enplug.Screensaver -u REDACTED_EMAIL -t  -p $1 osx -f Enplug\ Screen\ Saver.saver.zip; };f'
alias nvm_init="source ~/.dotfiles/scripts/nvm_init.sh"
alias cp="cp -R"

